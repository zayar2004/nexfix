"use client";

import { useState, useEffect } from "react";
import { AdminLayout } from "@/components/admin/AdminLayout";

type MediaItem = {
  id: string;
  storageKey: string;
  mime: string;
};

export default function HomeConfigPage() {
  const [locale, setLocale] = useState<"my" | "en">("en");
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState("");

  const [form, setForm] = useState({
    heroHeading: "Find Solutions\nKeep Machines Running",
    heroDescription: "Error codes, troubleshooting, and more for arcade technicians.",
    heroImageUrl: "/images/arcade-hero.jpg",
    isPublished: "draft",
  });

  // 🌟 Media Library Modal State
  const [showMediaPicker, setShowMediaPicker] = useState(false);
  const [mediaItems, setMediaItems] = useState<MediaItem[]>([]);
  const [loadingMedia, setLoadingMedia] = useState(false);

  useEffect(() => {
    setLoading(true);
    fetch(`/api/admin/home?locale=${locale}`)
      .then((res) => res.json())
      .then((data) => {
        if (data.ok && data.config) {
          setForm({
            heroHeading: data.config.heroHeading,
            heroDescription: data.config.heroDescription,
            heroImageUrl: data.config.heroImageUrl,
            isPublished: data.config.isPublished,
          });
        }
      })
      .finally(() => setLoading(false));
  }, [locale]);

  // 🌟 Media Library ကို ဖွင့်တဲ့ Function
  const openMediaPicker = async () => {
    setShowMediaPicker(true);
    setLoadingMedia(true);
    try {
      const res = await fetch("/api/admin/media");
      const data = await res.json();
      if (data.ok) setMediaItems(data.data);
    } catch {}
    setLoadingMedia(false);
  };

  const handleSave = async (publish: boolean) => {
    setSaving(true);
    setMessage("");
    try {
      const res = await fetch("/api/admin/home", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          locale,
          ...form,
          isPublished: publish ? "published" : "draft",
        }),
      });
      const data = await res.json();
      if (!data.ok) throw new Error(data.error);
      setMessage(publish ? "✅ Published!" : "💾 Saved as Draft");
    } catch (err) {
      setMessage("❌ Error: " + (err instanceof Error ? err.message : "Unknown"));
    } finally {
      setSaving(false);
    }
  };

  return (
    <AdminLayout title="Home Page Editor">
      <div className="max-w-3xl mx-auto">
        <div className="flex gap-2 mb-4">
          <button
            onClick={() => setLocale("en")}
            className={`px-4 py-2 rounded-lg text-sm font-medium ${locale === "en" ? "bg-[var(--nx-accent)] text-black" : "bg-[var(--nx-bg-card)] text-white"}`}
          >
            English
          </button>
          <button
            onClick={() => setLocale("my")}
            className={`px-4 py-2 rounded-lg text-sm font-medium ${locale === "my" ? "bg-[var(--nx-accent)] text-black" : "bg-[var(--nx-bg-card)] text-white"}`}
          >
            မြန်မာ
          </button>
        </div>

        {loading ? (
          <p className="text-white">Loading...</p>
        ) : (
          <div className="flex flex-col gap-4 bg-[var(--nx-bg-card)] border border-[var(--nx-border-updated)] rounded-xl p-4">
            <label className="flex flex-col gap-1">
              <span className="text-sm text-[var(--nx-text-muted-updated)]">Hero Heading</span>
              <textarea
                value={form.heroHeading}
                onChange={(e) => setForm({ ...form, heroHeading: e.target.value })}
                rows={2}
                className="bg-[var(--nx-bg-base-deep)] text-white border border-[var(--nx-border-updated)] rounded-lg p-2"
              />
            </label>

            <label className="flex flex-col gap-1">
              <span className="text-sm text-[var(--nx-text-muted-updated)]">Hero Description</span>
              <textarea
                value={form.heroDescription}
                onChange={(e) => setForm({ ...form, heroDescription: e.target.value })}
                rows={2}
                className="bg-[var(--nx-bg-base-deep)] text-white border border-[var(--nx-border-updated)] rounded-lg p-2"
              />
            </label>

            {/* 🌟 Hero Image (Media Picker နဲ့) */}
            <div className="flex flex-col gap-2">
              <span className="text-sm text-[var(--nx-text-muted-updated)]">Hero Image</span>
              
              {/* Preview */}
              {form.heroImageUrl && (
                <div className="w-full aspect-video bg-[var(--nx-bg-base-deep)] rounded-lg overflow-hidden border border-[var(--nx-border-updated)]">
                  <img
                    src={form.heroImageUrl}
                    alt="Hero preview"
                    className="w-full h-full object-cover"
                  />
                </div>
              )}

              <div className="flex gap-2">
                <input
                  type="text"
                  value={form.heroImageUrl}
                  onChange={(e) => setForm({ ...form, heroImageUrl: e.target.value })}
                  placeholder="/uploads/... or https://..."
                  className="flex-1 bg-[var(--nx-bg-base-deep)] text-white border border-[var(--nx-border-updated)] rounded-lg p-2 text-sm"
                />
                <button
                  onClick={openMediaPicker}
                  className="px-3 py-2 bg-[var(--nx-bg-surface-deep)] text-white text-sm rounded-lg border border-[var(--nx-border-updated)] hover:bg-[var(--nx-bg-elevated-deep)]"
                >
                  📁 Browse
                </button>
              </div>
            </div>

            <div className="flex gap-3 mt-2">
              <button
                onClick={() => handleSave(false)}
                disabled={saving}
                className="flex-1 py-3 bg-[var(--nx-bg-elevated-deep)] text-white font-semibold rounded-lg"
              >
                {saving ? "..." : "Save Draft"}
              </button>
              <button
                onClick={() => handleSave(true)}
                disabled={saving}
                className="flex-1 py-3 bg-[var(--nx-accent)] text-black font-bold rounded-lg"
              >
                {saving ? "..." : "Publish"}
              </button>
            </div>

            {message && <p className="text-center text-sm text-[var(--nx-success)]">{message}</p>}
          </div>
        )}
      </div>

      {/* 🌟 Media Picker Modal */}
      {showMediaPicker && (
        <div className="fixed inset-0 z-[1000] flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm" onClick={() => setShowMediaPicker(false)}>
          <div className="w-full max-w-2xl max-h-[80vh] bg-[var(--nx-bg-card)] border border-[var(--nx-border-updated)] rounded-2xl flex flex-col" onClick={(e) => e.stopPropagation()}>
            <div className="p-4 border-b border-[var(--nx-border-updated)] flex items-center justify-between">
              <h3 className="text-lg font-bold text-white">Select Image from Media Library</h3>
              <button onClick={() => setShowMediaPicker(false)} className="p-1 text-white hover:text-[var(--nx-error)]">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>

            <div className="flex-1 overflow-y-auto p-4">
              {loadingMedia ? (
                <p className="text-white text-center py-10">Loading media...</p>
              ) : mediaItems.length === 0 ? (
                <div className="text-center py-10 text-[var(--nx-text-muted-updated)]">
                  <p>No images in Media Library.</p>
                  <a href="/admin/media" className="inline-block mt-3 px-4 py-2 bg-[var(--nx-accent)] text-black font-bold rounded-lg text-sm">
                    Go to Media Library to Upload
                  </a>
                </div>
              ) : (
                <div className="grid grid-cols-2 sm:grid-cols-3 gap-3">
                  {mediaItems.map((m) => {
                    const S3_URL = process.env.NEXT_PUBLIC_S3_URL || "";
                    const url = `${S3_URL}/${m.storageKey}`;
                    return (
                      <button
                        key={m.id}
                        onClick={() => {
                          setForm({ ...form, heroImageUrl: url });
                          setShowMediaPicker(false);
                        }}
                        className="aspect-video bg-[var(--nx-bg-base-deep)] rounded-lg overflow-hidden border-2 border-transparent hover:border-[var(--nx-accent)] transition-colors"
                      >
                        <img src={url} alt={m.storageKey} className="w-full h-full object-cover" />
                      </button>
                    );
                  })}
                </div>
              )}
            </div>
          </div>
        </div>
      )}
    </AdminLayout>
  );
}
