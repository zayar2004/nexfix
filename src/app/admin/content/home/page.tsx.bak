"use client";

import { useState, useEffect } from "react";
import { AdminLayout } from "@/components/admin/AdminLayout";

type MediaItem = {
  id: string;
  storageKey: string;
  mime: string;
};

export default function HomeConfigPage() {
  const [locale, setLocale] = useState<"my" | "en">("en");
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState("");

  const [form, setForm] = useState({
    heroHeading: "Find Solutions\nKeep Machines Running",
    heroDescription: "Error codes, troubleshooting, and more for arcade technicians.",
    heroImages: [] as string[],
    isPublished: "draft",
  });

  const [showMediaPicker, setShowMediaPicker] = useState(false);
  const [mediaItems, setMediaItems] = useState<MediaItem[]>([]);
  const [loadingMedia, setLoadingMedia] = useState(false);
  
  // 🌟 URL ထည့်ဖို့ State အသစ်
  const [customUrl, setCustomUrl] = useState("");
  
  const S3_URL = process.env.NEXT_PUBLIC_S3_URL || "";

  useEffect(() => {
    setLoading(true);
    fetch(`/api/admin/home?locale=${locale}`)
      .then((res) => res.json())
      .then((data) => {
        if (data.ok && data.config) {
          let heroImages: string[] = [];
          if (data.config.heroImages) {
            try {
              const parsed = JSON.parse(data.config.heroImages);
              if (Array.isArray(parsed)) heroImages = parsed;
            } catch {}
          }
          if (heroImages.length === 0 && data.config.heroImageUrl) {
            heroImages = [data.config.heroImageUrl];
          }

          setForm({
            heroHeading: data.config.heroHeading || "Find Solutions\nKeep Machines Running",
            heroDescription: data.config.heroDescription || "Error codes, troubleshooting, and more for arcade technicians.",
            heroImages,
            isPublished: data.config.isPublished || "draft",
          });
        }
      })
      .finally(() => setLoading(false));
  }, [locale]);

  const openMediaPicker = async () => {
    setShowMediaPicker(true);
    setLoadingMedia(true);
    try {
      const res = await fetch("/api/admin/media");
      const data = await res.json();
      if (data.ok) setMediaItems(data.data);
    } catch {}
    setLoadingMedia(false);
  };

  const handleAddImage = (storageKey: string) => {
    const url = `${S3_URL}/${storageKey}`;
    if (!form.heroImages.includes(url)) {
      setForm({ ...form, heroImages: [...form.heroImages, url] });
    }
    setShowMediaPicker(false);
  };

  // 🌟 Custom URL ထည့်တဲ့ Function
  const handleAddCustomUrl = () => {
    if (!customUrl.trim()) return;
    if (form.heroImages.includes(customUrl.trim())) {
      alert("This URL is already added");
      return;
    }
    setForm({ ...form, heroImages: [...form.heroImages, customUrl.trim()] });
    setCustomUrl("");
    setShowMediaPicker(false);
  };

  const handleRemoveImage = (index: number) => {
    setForm({
      ...form,
      heroImages: form.heroImages.filter((_, i) => i !== index),
    });
  };

  const handleMoveImage = (index: number, direction: "up" | "down") => {
    const newImages = [...form.heroImages];
    const targetIndex = direction === "up" ? index - 1 : index + 1;
    if (targetIndex < 0 || targetIndex >= newImages.length) return;
    [newImages[index], newImages[targetIndex]] = [newImages[targetIndex], newImages[index]];
    setForm({ ...form, heroImages: newImages });
  };

  const handleSave = async (publish: boolean) => {
    setSaving(true);
    setMessage("");
    try {
      const res = await fetch("/api/admin/home", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          locale,
          heroHeading: form.heroHeading,
          heroDescription: form.heroDescription,
          heroImageUrl: form.heroImages[0] || "",
          heroImages: form.heroImages,
          isPublished: publish ? "published" : "draft",
        }),
      });
      const data = await res.json();
      if (!data.ok) throw new Error(data.error);
      setMessage(publish ? "✅ Published successfully!" : "💾 Saved as Draft");
    } catch (err) {
      setMessage("❌ Error: " + (err instanceof Error ? err.message : "Unknown"));
    } finally {
      setSaving(false);
    }
  };

  return (
    <AdminLayout title="Home Page Editor">
      <div className="max-w-3xl mx-auto">
        
        <div className="flex gap-2 mb-4">
          <button
            onClick={() => setLocale("en")}
            className={`px-4 py-2 rounded-lg text-sm font-semibold transition-colors ${locale === "en" ? "bg-[var(--nx-accent)] text-black" : "bg-[var(--nx-bg-card)] text-white border border-[var(--nx-border-updated)]"}`}
          >
            🇬🇧 English
          </button>
          <button
            onClick={() => setLocale("my")}
            className={`px-4 py-2 rounded-lg text-sm font-semibold transition-colors ${locale === "my" ? "bg-[var(--nx-accent)] text-black" : "bg-[var(--nx-bg-card)] text-white border border-[var(--nx-border-updated)]"}`}
          >
            🇲🇲 မြန်မာ
          </button>
        </div>

        {loading ? (
          <div className="flex justify-center py-10">
            <div className="w-8 h-8 border-4 border-[var(--nx-accent)] border-t-transparent rounded-full animate-spin"></div>
          </div>
        ) : (
          <div className="flex flex-col gap-4">
            
            <div className="bg-[var(--nx-bg-card)] border border-[var(--nx-border-updated)] rounded-2xl p-5">
              <h3 className="text-base font-bold text-white mb-4">Hero Content</h3>

              <label className="flex flex-col gap-1.5 mb-4">
                <span className="text-xs font-semibold text-[var(--nx-text-muted-updated)] uppercase">Hero Heading</span>
                <textarea
                  value={form.heroHeading}
                  onChange={(e) => setForm({ ...form, heroHeading: e.target.value })}
                  rows={2}
                  className="bg-[var(--nx-bg-base-deep)] text-white border border-[var(--nx-border-updated)] rounded-lg p-3 text-sm focus:outline-none focus:border-[var(--nx-accent)]"
                />
              </label>

              <label className="flex flex-col gap-1.5">
                <span className="text-xs font-semibold text-[var(--nx-text-muted-updated)] uppercase">Hero Description</span>
                <textarea
                  value={form.heroDescription}
                  onChange={(e) => setForm({ ...form, heroDescription: e.target.value })}
                  rows={2}
                  className="bg-[var(--nx-bg-base-deep)] text-white border border-[var(--nx-border-updated)] rounded-lg p-3 text-sm focus:outline-none focus:border-[var(--nx-accent)]"
                />
              </label>
            </div>

            <div className="bg-[var(--nx-bg-card)] border border-[var(--nx-border-updated)] rounded-2xl p-5">
              <div className="flex items-center justify-between mb-4">
                <div>
                  <h3 className="text-base font-bold text-white">Hero Images</h3>
                  <p className="text-xs text-[var(--nx-text-muted-updated)] mt-0.5">
                    {form.heroImages.length} image{form.heroImages.length !== 1 ? 's' : ''} · 10s auto-slide
                  </p>
                </div>
                <button
                  onClick={openMediaPicker}
                  className="px-3 py-2 bg-[var(--nx-accent)] text-black text-xs font-bold rounded-lg hover:brightness-110 flex items-center gap-1.5"
                >
                  + Add Image
                </button>
              </div>

              {form.heroImages.length === 0 ? (
                <div className="p-8 text-center border border-dashed border-[var(--nx-border-updated)] rounded-xl">
                  <p className="text-sm text-[var(--nx-text-muted-updated)]">No images yet</p>
                </div>
              ) : (
                <div className="flex flex-col gap-2">
                  {form.heroImages.map((url, idx) => (
                    <div key={idx} className="flex items-center gap-3 p-2 bg-[var(--nx-bg-base-deep)] border border-[var(--nx-border-updated)] rounded-lg">
                      <div className="w-16 h-10 rounded bg-[var(--nx-bg-surface-deep)] overflow-hidden flex-shrink-0">
                        <img src={url} alt={`Hero ${idx + 1}`} className="w-full h-full object-cover" />
                      </div>
                      <div className="flex-1 min-w-0">
                        <p className="text-xs font-semibold text-white">Image {idx + 1}</p>
                        <p className="text-[10px] text-[var(--nx-text-muted-updated)] truncate">{url}</p>
                      </div>
                      <div className="flex gap-1">
                        <button onClick={() => handleMoveImage(idx, "up")} disabled={idx === 0} className="p-1.5 text-[var(--nx-text-muted-updated)] hover:text-white disabled:opacity-30">
                          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
                        </button>
                        <button onClick={() => handleMoveImage(idx, "down")} disabled={idx === form.heroImages.length - 1} className="p-1.5 text-[var(--nx-text-muted-updated)] hover:text-white disabled:opacity-30">
                          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                        </button>
                        <button onClick={() => handleRemoveImage(idx)} className="p-1.5 text-[var(--nx-error)] hover:bg-[var(--nx-error)]/10 rounded">
                          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </button>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>

            <div className="flex gap-3">
              <button onClick={() => handleSave(false)} disabled={saving} className="flex-1 py-3 bg-[var(--nx-bg-card)] text-white font-semibold rounded-xl border border-[var(--nx-border-updated)] hover:bg-[var(--nx-bg-surface-deep)]">
                {saving ? "..." : "Save Draft"}
              </button>
              <button onClick={() => handleSave(true)} disabled={saving} className="flex-1 py-3 bg-[var(--nx-accent)] text-black font-bold rounded-xl hover:brightness-110">
                {saving ? "Publishing..." : "Publish"}
              </button>
            </div>

            {message && (
              <p className={`text-center text-sm font-semibold ${message.startsWith("✅") ? "text-[var(--nx-success)]" : message.startsWith("💾") ? "text-[var(--nx-accent)]" : "text-[var(--nx-error)]"}`}>
                {message}
              </p>
            )}
          </div>
        )}
      </div>

      {/* 🌟 Media Picker Modal (URL ထည့်တဲ့ နေရာ ပါ) */}
      {showMediaPicker && (
        <div className="fixed inset-0 z-[1000] flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm" onClick={() => setShowMediaPicker(false)}>
          <div className="w-full max-w-2xl max-h-[85vh] bg-[var(--nx-bg-card)] border border-[var(--nx-border-updated)] rounded-2xl flex flex-col" onClick={(e) => e.stopPropagation()}>
            
            <div className="p-4 border-b border-[var(--nx-border-updated)] flex items-center justify-between">
              <div>
                <h3 className="text-lg font-bold text-white">Add Image</h3>
                <p className="text-xs text-[var(--nx-text-muted-updated)]">{form.heroImages.length} selected</p>
              </div>
              <button onClick={() => setShowMediaPicker(false)} className="p-1 text-white hover:text-[var(--nx-error)]">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>

            {/* 🌟 Custom URL Input */}
            <div className="p-4 border-b border-[var(--nx-border-updated)]">
              <label className="text-xs font-semibold text-[var(--nx-text-muted-updated)] uppercase block mb-2">Or Paste Image URL</label>
              <div className="flex gap-2">
                <input
                  type="text"
                  value={customUrl}
                  onChange={(e) => setCustomUrl(e.target.value)}
                  onKeyDown={(e) => e.key === "Enter" && handleAddCustomUrl()}
                  placeholder="https://example.com/image.jpg"
                  className="flex-1 bg-[var(--nx-bg-base-deep)] text-white border border-[var(--nx-border-updated)] rounded-lg p-2.5 text-sm focus:outline-none focus:border-[var(--nx-accent)]"
                />
                <button
                  onClick={handleAddCustomUrl}
                  disabled={!customUrl.trim()}
                  className="px-4 py-2 bg-[var(--nx-accent)] text-black text-sm font-bold rounded-lg disabled:opacity-50"
                >
                  Add
                </button>
              </div>
            </div>

            {/* 🌟 Media Library Grid */}
            <div className="flex-1 overflow-y-auto p-4">
              <div className="flex items-center justify-between mb-3">
                <p className="text-xs font-semibold text-[var(--nx-text-muted-updated)] uppercase">From Media Library</p>
                <a href="/admin/media" className="text-xs text-[var(--nx-accent)] hover:underline font-semibold">+ Upload New</a>
              </div>

              {loadingMedia ? (
                <p className="text-white text-center py-10">Loading...</p>
              ) : mediaItems.length === 0 ? (
                <div className="text-center py-10 text-[var(--nx-text-muted-updated)]">
                  <p className="text-sm">No images in Media Library</p>
                  <a href="/admin/media" className="inline-block mt-3 px-4 py-2 bg-[var(--nx-accent)] text-black font-bold rounded-lg text-sm">
                    Go to Media Library
                  </a>
                </div>
              ) : (
                <div className="grid grid-cols-2 sm:grid-cols-3 gap-3">
                  {mediaItems.map((m) => {
                    const url = `${S3_URL}/${m.storageKey}`;
                    const isSelected = form.heroImages.includes(url);
                    return (
                      <button
                        key={m.id}
                        onClick={() => !isSelected && handleAddImage(m.storageKey)}
                        disabled={isSelected}
                        className={`relative aspect-video bg-[var(--nx-bg-base-deep)] rounded-lg overflow-hidden border-2 transition-all ${isSelected ? "border-[var(--nx-success)] cursor-not-allowed" : "border-transparent hover:border-[var(--nx-accent)]"}`}
                      >
                        <img src={url} alt={m.storageKey} className="w-full h-full object-cover" />
                        {isSelected && (
                          <div className="absolute inset-0 bg-[var(--nx-success)]/30 backdrop-blur-[1px] flex items-center justify-center">
                            <div className="bg-[var(--nx-success)] text-black px-2 py-1 rounded text-[10px] font-bold flex items-center gap-1">
                              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                              Added
                            </div>
                          </div>
                        )}
                      </button>
                    );
                  })}
                </div>
              )}
            </div>
          </div>
        </div>
      )}
    </AdminLayout>
  );
}
