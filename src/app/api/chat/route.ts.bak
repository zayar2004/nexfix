import { NextResponse } from "next/server";
import { db } from "@/db";
import { chatMessages, users } from "@/db/schema";
import { auth } from "@/auth";
import { eq, desc, gt } from "drizzle-orm";
import { z } from "zod";

const messageSchema = z.object({
  content: z.string().min(1).max(500),
});

async function getMessages(after?: string) {
  let query = db
    .select({
      id: chatMessages.id,
      content: chatMessages.content,
      createdAt: chatMessages.createdAt,
      userId: chatMessages.userId,
      userName: users.displayName,
      userEmail: users.email,
    })
    .from(chatMessages)
    .leftJoin(users, eq(chatMessages.userId, users.id))
    .orderBy(desc(chatMessages.createdAt))
    .limit(50);

  if (after) {
    return await db
      .select({
        id: chatMessages.id,
        content: chatMessages.content,
        createdAt: chatMessages.createdAt,
        userId: chatMessages.userId,
        userName: users.displayName,
        userEmail: users.email,
      })
      .from(chatMessages)
      .leftJoin(users, eq(chatMessages.userId, users.id))
      .where(gt(chatMessages.createdAt, new Date(after)))
      .orderBy(chatMessages.createdAt);
  }
  
  const messages = await query;
  return messages.reverse();
}

// GET: Support both normal and SSE mode
export async function GET(req: Request) {
  const { searchParams } = new URL(req.url);
  const stream = searchParams.get("stream");
  const after = searchParams.get("after") || undefined;

  // 🌟 SSE Mode
  if (stream === "true") {
    const encoder = new TextEncoder();
    const stream = new ReadableStream({
      async start(controller) {
        let lastId = after || null;
        let isActive = true;

        // Client က ဖြတ်သွားရင် ပိတ်မယ်
        req.signal.addEventListener("abort", () => {
          isActive = false;
        });

        // တစ်ခါ ချက်ချင်း ပို့မယ်
        try {
          const messages = await getMessages(lastId || undefined);
          if (messages.length > 0) {
            lastId = String(messages[messages.length - 1].createdAt);
          }
          controller.enqueue(encoder.encode(`data: ${JSON.stringify({ type: "init", messages })}\n\n`));
        } catch (err) {
          controller.enqueue(encoder.encode(`data: ${JSON.stringify({ type: "error" })}\n\n`));
        }

        // ပြီးရင် ၁ စက္ကန့်တစ်ခါ စာသစ် ရှိမရှိ စစ်မယ်
        const interval = setInterval(async () => {
          if (!isActive) {
            clearInterval(interval);
            controller.close();
            return;
          }

          try {
            const newMessages = await getMessages(lastId || undefined);
            if (newMessages.length > 0) {
              lastId = String(newMessages[newMessages.length - 1].createdAt);
              controller.enqueue(encoder.encode(`data: ${JSON.stringify({ type: "new", messages: newMessages })}\n\n`));
            }
          } catch (err) {
            // ignore
          }
        }, 1000);

        // Timeout (၅ မိနစ်) ဆိုရင် ပိတ်မယ်
        setTimeout(() => {
          clearInterval(interval);
          if (isActive) controller.close();
        }, 5 * 60 * 1000);
      },
    });

    return new Response(stream, {
      headers: {
        "Content-Type": "text/event-stream",
        "Cache-Control": "no-cache, no-transform",
        "Connection": "keep-alive",
      },
    });
  }

  // Normal Mode (Fallback)
  try {
    const messages = await getMessages(after || undefined);
    return NextResponse.json({ ok: true, data: messages });
  } catch (err) {
    return NextResponse.json({ ok: false, error: "Failed to load" }, { status: 500 });
  }
}

// POST: Send new message
export async function POST(req: Request) {
  try {
    const session = await auth();
    if (!session?.user?.id) {
      return NextResponse.json({ ok: false, error: "Login required" }, { status: 401 });
    }

    const body = await req.json();
    const result = messageSchema.safeParse(body);
    if (!result.success) {
      return NextResponse.json({ ok: false, error: "Invalid message" }, { status: 400 });
    }

    const [newMessage] = await db
      .insert(chatMessages)
      .values({
        userId: session.user.id,
        content: result.data.content,
      })
      .returning();

    return NextResponse.json({ ok: true, data: newMessage });
  } catch (err) {
    return NextResponse.json({ ok: false, error: "Failed to send" }, { status: 500 });
  }
}
